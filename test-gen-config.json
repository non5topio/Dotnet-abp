{
  "enabled": "true",
  "increase-coverage": {
    "project-name": "dotnet-abp-framework",
    "target-branches": [
      "main",
      "master",
      "dev"
    ],
    "test-env-docker-stage": "test",
    "build-test-env-docker-stage-script-path": "tool/build-test-env-docker-stage.sh",
    "test-files-folders": [
      "framework/test/Volo.Abp.Core.Tests/Volo/Abp/RandomHelper_Tests.cs"
    ],
    "source-test-file-paths": [
      {
        "source-file-path": "framework/src/Volo.Abp.Core/Volo/Abp/RandomHelper.cs",
        "test-file-path": "framework/test/Volo.Abp.Core.Tests/Volo/Abp/RandomHelper_Tests.cs"
      }
    ],
    "test-command": "dotnet test ./framework/test/Volo.Abp.Core.Tests/Volo.Abp.Core.Tests.csproj --filter \"FullyQualifiedName~Volo.Abp.RandomHelper_Tests\" --collect:'XPlat Code Coverage' --results-directory ./TestResults && find ./TestResults -name 'coverage.cobertura.xml' -exec cp {} ./TestResults/coverage.cobertura.xml \\;",
    "coverage-type": "cobertura",
    "code-coverage-report-path": "TestResults/coverage.cobertura.xml",
    "desired-coverage": 85,
    "max-iterations": 3,
    "max-number-of-test-cases": 8
  }
}
